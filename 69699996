RunService.RenderStepped:Connect(function()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local char = p.Character
			local hl = char:FindFirstChild("MM2EspHL")
			if mm2espEnabled then
				local role = "Innocent"
				local function check(container)
					if not container then return end
					for _, item in ipairs(container:GetChildren()) do
						if item:IsA("Tool") then
							local n = item.Name:lower()
							if n:find("knife") or n:find("blade") then role = "Murderer"
							elseif n:find("gun") or n:find("revolver") then role = "Sheriff" end
						end
					end
				end
				check(char)
				if p:FindFirstChild("Backpack") then check(p.Backpack) end

				local col = Color3.fromRGB(0, 255, 0)
				if role == "Murderer" then col = Color3.fromRGB(255, 0, 0)
				elseif role == "Sheriff" then col = Color3.fromRGB(0, 100, 255) end

				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "MM2EspHL"
					hl.Adornee = char
					hl.AlwaysOnTop = true
					hl.Parent = char
				end
				hl.FillColor = col
				hl.OutlineColor = col
			end
		end
	end
end)

