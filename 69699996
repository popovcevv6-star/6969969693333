	speedOn = not speedOn
	speedBtn.Text = speedOn and "ON" or "OFF"
	speedBtn.BackgroundColor3 = speedOn and Color3.fromRGB(70, 255, 70) or Color3.fromRGB(255, 70, 70)
end)

RunService.Heartbeat:Connect(function()
	if speedOn then
		local chr = player.Character
		local hum = chr and chr:FindFirstChildWhichIsA("Humanoid")
		if hum and hum.MoveDirection.Magnitude > 0 then
			local moveDir = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
			if moveDir.Magnitude > 0 then
				pcall(function() chr:TranslateBy(moveDir.Unit * (0.15 * speeds)) end)
			end
		end
	end
end)

