-- Aim & Silent Aim & Hitboxes
RunService.RenderStepped:Connect(function()
	if aimEnabled then
		pcall(function()
			local closestPlayer, closestDist = nil, math.huge
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
					local hum = p.Character:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						local screenPoint, onScreen = Camera:WorldToScreenPoint(p.Character.Head.Position)
						if onScreen then
							local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
							if dist < closestDist then closestDist, closestPlayer = dist, p end
						end
					end
				end
			end
			if closestPlayer then Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestPlayer.Character.Head.Position) end
		end)
	end

	if fovEnabled then Camera.FieldOfView = 100 else Camera.FieldOfView = 70 end

	if spinbotEnabled then
		pcall(function()
			local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(50), 0) end
		end)
	end
end)

-- Silent Aim Hook
pcall(function()
	local mouse = LocalPlayer:GetMouse()
	local mt = getrawmetatable(mouse)
	if mt then
		setreadonly(mt, false)
		local oldIndex = mt.__index
		mt.__index = newcclosure(function(self, idx)
			if silentEnabled and idx == "Hit" then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
						local hum = p.Character:FindFirstChildOfClass("Humanoid")
						if hum and hum.Health > 0 then return CFrame.new(p.Character.Head.Position) end
					end
				end
			end
			return oldIndex(self, idx)
		end)
		setreadonly(mt, true)
	end
end)

-- Hitboxes & Bhop & Follow/Attach
RunService.Heartbeat:Connect(function()
	if hitboxesEnabled then
		pcall(function()
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local hrp = p.Character.HumanoidRootPart
					hrp.Size = Vector3.new(5, 5, 5)
					hrp.Transparency = 0.7
					hrp.CanCollide = false
				end
			end
		end)
	end

	if bhopEnabled then
		pcall(function()
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.FloorMaterial ~= Enum.Material.Air then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
				currentBhopSpeed = math.min(48, currentBhopSpeed + 4)
				hum.WalkSpeed = currentBhopSpeed
			end
		end)
	end

	if followplayerEnabled or attachtotargetEnabled then
		pcall(function()
			local target, minDist = nil, math.huge
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (p.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
					if dist < minDist then minDist, target = dist, p end
				end
			end
			if target and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local myHrp = LocalPlayer.Character.HumanoidRootPart
				local tHrp = target.Character.HumanoidRootPart
				if attachtotargetEnabled then
					myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 3, 2)
				elseif followplayerEnabled then
					LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):MoveTo(tHrp.Position)
				end
			end
		end)
	end
end)

-- Freecam Logic
RunService.RenderStepped:Connect(function()
	if freecamEnabled then
		pcall(function()
			Camera.CameraType = Enum.CameraType.Scriptable
			local camCFrame = Camera.CFrame
			local speed = 1
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then Camera.CFrame = camCFrame + (camCFrame.LookVector * speed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then Camera.CFrame = camCFrame - (camCFrame.LookVector * speed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then Camera.CFrame = camCFrame + (-camCFrame.RightVector * speed) end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then Camera.CFrame = camCFrame + (camCFrame.RightVector * speed) end
		end)
	else
		Camera.CameraType = Enum.CameraType.Custom
	end
end)

-- MM2 Role ESP Logic (Убийца - Красный, Шериф - Синий, Невинные - Зеленый)
RunService.RenderStepped:Connect(function()
	if mm2espEnabled then
		pcall(function()
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character then
					local role = "Innocent"
					-- Проверяем инвентарь и руки на наличие ножа (Murderer) или пистолета (Sheriff)
					local function checkItems(container)
						if not container then return end
						for _, item in ipairs(container:GetChildren()) do
							if item:IsA("Tool") then
								local name = item.Name:lower()
								if name:find("knife") or name:find("blade") or name:find("dagger") then
									role = "Murderer"
								elseif name:find("gun") or name:find("revolver") or name:find("sheriff") then
									role = "Sheriff"
								end
							end
						end
					end
					checkItems(p.Character)
					if p:FindFirstChild("Backpack") then checkItems(p.Backpack) end

					local color = Color3.fromRGB(0, 255, 0) -- Зеленый (Innocent)
					if role == "Murderer" then
						color = Color3.fromRGB(255, 0, 0) -- Красный (Мардер)
					elseif role == "Sheriff" then
						color = Color3.fromRGB(0, 100, 255) -- Синий (Шериф)
					end

					for _, part in ipairs(p.Character:GetDescendants()) do
						if part:IsA("BasePart") then
							local hl = part:FindFirstChild("MM2EspHighlight")
							if not hl then
								hl = Instance.new("Highlight")
								hl.Name = "MM2EspHighlight"
								hl.Adornee = p.Character
								hl.Parent = part
							end
							hl.FillColor = color
							hl.OutlineColor = color
						end
					end
				end
			end
		end)
	else
		pcall(function()
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Character then
					for _, part in ipairs(p.Character:GetDescendants()) do
						local hl = part:FindFirstChild("MM2EspHighlight")
						if hl then hl:Destroy() end
					end
				end
			end
		end)
	end
end)

