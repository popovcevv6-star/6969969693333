-- ESP Box Drawing
local espBoxes = {}
local function createEspBox(player)
	local box = Drawing.new("Square")
	box.Color = Color3.fromRGB(255, 0, 0)
	box.Thickness = 1.5
	box.Filled = false
	box.Transparency = 1
	box.Visible = false
	espBoxes[player] = box
end

for _, p in ipairs(Players:GetPlayers()) do
	if p ~= LocalPlayer then createEspBox(p) end
end
Players.PlayerAdded:Connect(function(p) createEspBox(p) end)
Players.PlayerRemoving:Connect(function(p)
	if espBoxes[p] then
		espBoxes[p]:Remove()
		espBoxes[p] = nil
	end
end)

