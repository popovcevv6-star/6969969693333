local noAnimBtn = createFunction("No Animation")
noAnimBtn.MouseButton1Down:Connect(function()
	noAnimOn = not noAnimOn
	noAnimBtn.Text = noAnimOn and "ON" or "OFF"
	noAnimBtn.BackgroundColor3 = noAnimOn and Color3.fromRGB(70, 255, 70) or Color3.fromRGB(255, 70, 70)
end)

RunService.Heartbeat:Connect(function()
	if noAnimOn then
		local chr = player.Character
		local animScript = chr and chr:FindFirstChild("Animate")
		local hum = chr and chr:FindFirstChildWhichIsA("Humanoid")
		
		if animScript and animScript.Enabled then
			animScript.Enabled = false
		end
		
		if hum then
			local animator = hum:FindFirstChildWhichIsA("Animator")
			if animator then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					track:Stop(0)
				end
			end
		end
	else
		local chr = player.Character
		local animScript = chr and chr:FindFirstChild("Animate")
		if animScript and not animScript.Enabled then
			animScript.Enabled = true
		end
	end
end)

-- 6. FLING (Интегрированная рабочая логика из скриншота)
local flingBtn = createFunction("Fling")

local function flingLogic()
	local c, hrp, vel, movel = nil, nil, nil, 0.1
	while hiddenfling do
		RunService.Heartbeat:Wait()
		c = player.Character
		hrp = c and c:FindFirstChild("HumanoidRootPart")
		if hrp then
			vel = hrp.Velocity
			hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
			RunService.RenderStepped:Wait()
			hrp.Velocity = vel
			RunService.Stepped:Wait()
			hrp.Velocity = vel + Vector3.new(0, movel, 0)
			movel = -movel
		end
	end
end

flingBtn.MouseButton1Down:Connect(function()
	hiddenfling = not hiddenfling
	flingBtn.Text = hiddenfling and "ON" or "OFF"
	flingBtn.BackgroundColor3 = hiddenfling and Color3.fromRGB(70, 255, 70) or Color3.fromRGB(255, 70, 70)
	
	if hiddenfling then
		flingThread = coroutine.create(flingLogic)
		coroutine.resume(flingThread)
	else
		hiddenfling = false
	end
end)

-- 7. REFLASH (Перемотка назад на 2 секунды)
local reflashBtn, reflashItem = createActionFunction("Reflash")
local positionHistory = {}

task.spawn(function()
	while true do
		task.wait(0.1)
		local chr = player.Character
		local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
		if hrp then
			table.insert(positionHistory, 1, hrp.CFrame)
			if #positionHistory > 20 then
				table.remove(positionHistory, #positionHistory)
			end
		end
	end
end)

reflashBtn.MouseButton1Down:Connect(function()
	local chr = player.Character
	local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
	if hrp and #positionHistory >= 20 then
		pcall(function()
			hrp.CFrame = positionHistory[20]
			hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end)
	elseif hrp and #positionHistory > 0 then
		pcall(function()
			hrp.CFrame = positionHistory[#positionHistory]
			hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end)
	end
end)

