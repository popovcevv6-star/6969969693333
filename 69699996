local function createTab(name)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Parent = TabsContainer
	tabBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	tabBtn.Size = UDim2.new(0, 40, 0, 22)
	tabBtn.Text = name
	tabBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
	tabBtn.TextSize = 10
	tabBtn.Font = Enum.Font.SourceSansBold
	roundCorners(tabBtn, 4)

	local Container = Instance.new("ScrollingFrame")
	Container.Parent = MainFrame
	Container.BackgroundTransparency = 1
	Container.Position = UDim2.new(0, 0, 0, 56)
	Container.Size = UDim2.new(1, 0, 1, -56)
	Container.CanvasSize = UDim2.new(0, 0, 0, 0)
	Container.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Container.ScrollBarThickness = 4
	Container.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 100)
	Container.Visible = false

	local UIList = Instance.new("UIListLayout")
	UIList.Parent = Container
	UIList.HorizontalAlignment = Enum.HorizontalAlignment.Center
	UIList.SortOrder = Enum.SortOrder.LayoutOrder
	UIList.Padding = UDim.new(0, 6)

	local UIPadding = Instance.new("UIPadding")
	UIPadding.Parent = Container
	UIPadding.PaddingBottom = UDim.new(0, 10)
	UIPadding.PaddingTop = UDim.new(0, 4)

	containers[name] = Container
	tabButtons[name] = tabBtn

	tabBtn.MouseButton1Down:Connect(function()
		for _, c in pairs(containers) do c.Visible = false end
		for _, b in pairs(tabButtons) do 
			b.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			b.TextColor3 = Color3.fromRGB(180, 180, 180)
		end
		Container.Visible = true
		tabBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
		tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)

	return Container
end

